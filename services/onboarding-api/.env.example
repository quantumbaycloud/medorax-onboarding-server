ENVIRONMENT=development
APP_NAME=Medorax API
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000
ENABLE_DOCS=true

DATABASE_URL=postgresql+asyncpg://medorax:CHANGE_ME_DB_PASSWORD@postgres:5432/medorax
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_64_BYTE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Fernet key for encrypting selected sensitive DB fields. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

FRONTEND_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1

MAX_REQUEST_BYTES=10485760
MAX_UPLOAD_BYTES=10485760

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@medorax.in
SMTP_STARTTLS=true

# Development fallback: verification/reset links are logged by the API when SMTP is not configured.
PUBLIC_BASE_URL=http://localhost:8000

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

RATE_LIMIT_GLOBAL=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_OTP=3/10minutes
RATE_LIMIT_UPLOAD=10/minute

ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
