import logging

import httpx

from app.core.config import settings


logger = logging.getLogger("medorax-admin.provisioning")


def _erp_payload(payload: dict) -> dict:
    """Map Admin application detail data to the MEDORAX ERP provisioning contract."""
    user = payload.get("user") or {}
    business = payload.get("business") or {}
    bank = payload.get("bank") or {}

    name = str(business.get("name") or "").strip()
    if not name:
        raise ValueError("Approved application has no business name")

    erp_user = {
        "name": user.get("fullName") or user.get("name"),
        "email": user.get("email"),
        "phone": user.get("mobileNumber") or user.get("phone"),
    }

    erp_business = {
        "name": name,
        "gst_number": (
            business.get("gstNumber")
            or business.get("gst_number")
        ),
        "pan_number": (
            business.get("panNumber")
            or business.get("pan_number")
        ),
        "address": (
            business.get("formattedAddress")
            or business.get("address")
        ),
        "contact_phone": (
            business.get("contactNumber")
            or business.get("contact_phone")
        ),
        "contact_email": (
            business.get("email")
            or business.get("contact_email")
        ),
        "bank_account_number": (
            bank.get("accountNumber")
            or bank.get("account_number")
        ),
        "bank_ifsc": (
            bank.get("ifscCode")
            or bank.get("bank_ifsc")
        ),
        "bank_name": (
            bank.get("bankName")
            or bank.get("bank_name")
        ),
    }

    return {
        "source": payload.get(
            "source",
            "medorax-onboarding",
        ),
        "applicationId": payload.get("applicationId"),
        "userId": payload.get("userId"),
        "businessType": payload.get("businessType"),
        "pharmacyId": payload.get("pharmacyId"),
        "licenseKey": payload.get("licenseKey"),
        "licenseExpiresAt": payload.get(
            "licenseExpiresAt"
        ),
        "license": payload.get("license"),
        "licenseSignature": payload.get(
            "licenseSignature"
        ),
        "erpUsername": payload.get("erpUsername"),
        "temporaryPassword": payload.get(
            "temporaryPassword"
        ),
        "user": erp_user,
        "business": erp_business,
    }


async def provision_erp(payload: dict):
    """
    Provision an approved applicant into the ERP.

    This function only handles Admin -> ERP provisioning.
    The Admin approval/rejection workflow is intentionally untouched.
    """

    if not settings.erp_provision_url:
        return {
            "status": "failed",
            "externalId": None,
            "error": (
                "ERP_PROVISION_URL is not configured."
            ),
        }

    if not settings.erp_provision_token:
        return {
            "status": "failed",
            "externalId": None,
            "error": (
                "ERP_PROVISION_TOKEN is not configured."
            ),
        }

    endpoint = settings.erp_provision_url.rstrip("/")

    if not endpoint.endswith(
        "/internal/erp/provision"
    ):
        return {
            "status": "failed",
            "externalId": None,
            "error": (
                "ERP_PROVISION_URL must target "
                "/internal/erp/provision."
            ),
        }

    try:
        erp_payload = _erp_payload(payload)

        required = (
            "pharmacyId",
            "licenseKey",
            "license",
            "licenseSignature",
            "erpUsername",
            "temporaryPassword",
        )

        missing = [
            key
            for key in required
            if not erp_payload.get(key)
        ]

        if missing:
            return {
                "status": "failed",
                "externalId": None,
                "error": (
                    "ERP provisioning payload is missing: "
                    + ", ".join(missing)
                ),
            }

        headers = {
            "Content-Type": "application/json",
            "Accept": "application/json",
            "Authorization": (
                f"Bearer {settings.erp_provision_token}"
            ),
        }

        async with httpx.AsyncClient(
            timeout=settings.erp_timeout_seconds
        ) as client:
            response = await client.post(
                endpoint,
                json=erp_payload,
                headers=headers,
            )

        if response.status_code >= 400:
            error_text = response.text[:1000]

            logger.error(
                "ERP provisioning failed: "
                "status=%s response=%s",
                response.status_code,
                error_text,
            )

            return {
                "status": "failed",
                "externalId": None,
                "error": (
                    f"ERP returned HTTP "
                    f"{response.status_code}: "
                    f"{error_text}"
                ),
            }

        data = (
            response.json()
            if response.content
            else {}
        )

        if data.get("status") != "provisioned":
            return {
                "status": "failed",
                "externalId": None,
                "error": (
                    "ERP returned an unexpected "
                    "provisioning status."
                ),
                "response": data,
            }

        external_id = data.get("externalId")

        if not external_id:
            return {
                "status": "failed",
                "externalId": None,
                "error": (
                    "ERP provisioning response did "
                    "not contain externalId."
                ),
                "response": data,
            }

        logger.info(
            "ERP provisioning successful: "
            "external_id=%s",
            external_id,
        )

        return {
            "status": "provisioned",
            "externalId": str(external_id),
            "error": None,
            "response": data,
        }

    except httpx.TimeoutException:
        logger.exception(
            "ERP provisioning timeout"
        )

        return {
            "status": "failed",
            "externalId": None,
            "error": "ERP provisioning timed out.",
        }

    except httpx.RequestError:
        logger.exception(
            "ERP provisioning request failed"
        )

        return {
            "status": "failed",
            "externalId": None,
            "error": "ERP provisioning request failed.",
        }

    except Exception as exc:
        logger.exception(
            "Unexpected ERP provisioning error"
        )

        return {
            "status": "failed",
            "externalId": None,
            "error": str(exc)[:1000],
        }
